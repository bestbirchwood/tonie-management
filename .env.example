# Kopiere diese Datei nach .env und trage deine Daten ein (oder nutze ./install.sh).
# .env enthält dein Passwort – niemals einchecken oder weitergeben!

# Zugangsdaten deines tonies-Kontos (my.tonies.com)
TONIES_USER=deine@email.example
TONIES_PASS=dein-passwort

# Ordner mit den Hörspielen auf diesem Rechner (je Kreativ-Tonie ein Unterordner)
HOERSPIEL_ORDNER=./hoerspiele

# Standard-Uhrzeit für neue Tonies (je Tonie in der Weboberfläche änderbar)
UHRZEIT=17:30
# Nach jeder Runde: reihenfolge | zufall
MODUS=reihenfolge

# Optional
PORT=8095
TZ=Europe/Berlin
# Längere Folgen werden übersprungen (Kreativ-Tonie fasst ca. 90 Minuten)
MAX_MINUTEN=89
